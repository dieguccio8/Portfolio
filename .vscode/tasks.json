{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Portfolio: preview automatica",
      "type": "shell",
      "command": "cd \"${workspaceFolder}/WebApp\" && npm run dev -- --host 127.0.0.1 --strictPort",
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "vite",
          "endsPattern": "Local:"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
