{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Portfolio: preview automatica",
      "type": "shell",
      "command": "npm run dev -- --open /Portfolio/?project=aetheris",
      "options": {
        "cwd": "${workspaceFolder}/WebApp"
      },
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "vite",
          "endsPattern": "Local:"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
